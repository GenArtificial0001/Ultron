# =============================================================================
# Vision - Configuracion
# Copiar este archivo a `.env` y completar lo que haga falta. El `.env` real
# NUNCA se versiona (ver .gitignore).
#
# Donde va el .env:
#   - Modo desarrollo (Iniciar-Vision.bat, VISION_DEV_MODE=1): backend\.env
#   - Vision.exe / launch_vision.py:  %LOCALAPPDATA%\Vision-personal\.env
# Las claves tambien se pueden cargar desde la app, en Configuracion >
# Credenciales (se guardan cifradas en .env.enc, junto al .env).
# =============================================================================

# -----------------------------------------------------------------------------
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL (obligatorio)
# -----------------------------------------------------------------------------
# anthropic          -> Claude, con una clave de https://console.anthropic.com
# openai_compatible  -> OpenAI, Azure OpenAI o el gateway de tu empresa
#                       (en ese caso LLM_BASE_URL es obligatorio)
LLM_PROVIDER=anthropic
# Solo para openai_compatible (con anthropic se usa https://api.anthropic.com/v1/).
# Ejemplos: https://api.openai.com/v1  |  https://<gateway-de-tu-empresa>/v1
LLM_BASE_URL=
LLM_API_KEY=
# Modelo por defecto (el selector de la app permite elegir otro).
LLM_MODEL=claude-sonnet-5
# Opcional: modelos que ofrece el selector, separados por comas. Si queda
# vacio, se usa la lista que publica el proveedor.
LLM_MODELS=

# -----------------------------------------------------------------------------
# DICTADO POR VOZ (opcional)
# -----------------------------------------------------------------------------
# Un servicio compatible con /audio/transcriptions de OpenAI. Sin completar,
# los botones del microfono avisan que el dictado no esta configurado.
# Ejemplo con OpenAI: STT_BASE_URL=https://api.openai.com/v1  STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# -----------------------------------------------------------------------------
# EMPRESA
# -----------------------------------------------------------------------------
# Nombre que Vision muestra en la pantalla de inicio y usa al presentarse.
VISION_COMPANY_NAME=

# -----------------------------------------------------------------------------
# PROXY DE LA EMPRESA (opcional)
# -----------------------------------------------------------------------------
# Si la red de tu empresa sale a internet por un proxy. Lo usan las llamadas
# al proveedor de IA, al dictado y a los conectores. localhost siempre va
# directo. Ejemplo: http://proxy.tu-empresa.com:8080
HTTP_PROXY=
HTTPS_PROXY=
# Direcciones que NO pasan por el proxy, separadas por comas.
NO_PROXY=

# -----------------------------------------------------------------------------
# SERVIDOR WEB
# -----------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8030
CORS_ORIGINS=
# Token compartido para exponer el backend en la red local (ej. APP_HOST=
# 0.0.0.0 para usarlo desde un celular). Vacio = sin autenticacion (seguro
# solo en 127.0.0.1). Si se completa, el frontend usa el mismo valor
# (pantalla "Conectar a servidor").
ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# WORKSPACE (raiz por defecto de las herramientas de archivos y comandos)
# -----------------------------------------------------------------------------
WORKSPACE_DIR=./workspace
SKILLS_DIR=../skills
AUDIT_LOG_PATH=./logs/audit.log

# -----------------------------------------------------------------------------
# CONECTORES (todos opcionales; ENABLE_* en false los oculta)
# -----------------------------------------------------------------------------
# Oracle
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_SCHEMA=

# Google BigQuery (clave de cuenta de servicio en keys\, nunca versionada)
BQ_PROJECT_ID=
BQ_DATASET_ID=
BQ_TABLE_ID=
GOOGLE_APPLICATION_CREDENTIALS=./keys/bigquery_key.json
BQ_LOCATION=US

# SharePoint / Microsoft Graph (App Registration de Microsoft Entra ID)
SHAREPOINT_SITE_URL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_DEFAULT_LIST_NAME=

# SAP (Fiori / OData v2)
SAP_BASE_URL=
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=
SAP_LANGUAGE=EN

ENABLE_ORACLE=false
ENABLE_BIGQUERY=false
ENABLE_SHAREPOINT=false
ENABLE_SAP=false
